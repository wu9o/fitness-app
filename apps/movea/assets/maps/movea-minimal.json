{
  "version": 8,
  "name": "Movea Minimal",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors · OpenFreeMap"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F7F8F5"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#DCEFF2",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 10,
      "paint": {
        "line-color": "#DCEFF2",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.8,
          15,
          3
        ]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#E8F2E9",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "line-color": "#CFE3D2",
        "line-width": 1,
        "line-opacity": 0.7
      }
    },
    {
      "id": "sports-areas",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "pitch",
        "recreation_ground",
        "cemetery"
      ],
      "paint": {
        "fill-color": "#EAF3E7",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "paint": {
        "line-color": "#D2DBD8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          0.8,
          14,
          3.2,
          17,
          5
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "local-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "tertiary",
        "residential"
      ],
      "paint": {
        "line-color": "#E5EAE8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.5,
          17,
          1.5
        ],
        "line-opacity": 0.7
      }
    },
    {
      "id": "waterway-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 11,
      "filter": [
        "in",
        "geometry-type",
        "LineString",
        "MultiLineString"
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 420,
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["concat", ["get", "name:latin"], " ", ["get", "name:nonlatin"]],
          ["coalesce", ["get", "name"], ["get", "name:latin"]]
        ],
        "text-font": ["Noto Sans Italic"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#7FAEB2",
        "text-halo-color": "#F7F8F5",
        "text-halo-width": 1
      }
    },
    {
      "id": "neighborhood-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11.5,
      "filter": [
        "in",
        "class",
        "suburb",
        "quarter",
        "neighbourhood",
        "district"
      ],
      "layout": {
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["get", "name:nonlatin"],
          ["coalesce", ["get", "name"], ["get", "name:latin"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11.5,
          10,
          15,
          13
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#7A8581",
        "text-halo-color": "#F7F8F5",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "major-road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12.5,
      "filter": [
        "in",
        "class",
        "primary",
        "secondary",
        "tertiary",
        "trunk"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["get", "name:nonlatin"],
          ["coalesce", ["get", "name"], ["get", "name:latin"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12.5,
          10,
          15,
          12
        ],
        "text-max-angle": 30,
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#8A9490",
        "text-halo-color": "#F7F8F5",
        "text-halo-width": 1
      }
    },
    {
      "id": "minor-road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14.5,
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "track"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["get", "name:nonlatin"],
          ["coalesce", ["get", "name"], ["get", "name:latin"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#A0A9A5",
        "text-halo-color": "#F7F8F5",
        "text-halo-width": 0.8
      }
    },
    {
      "id": "sports-poi-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "park",
        "stadium",
        "sports_centre",
        "attraction"
      ],
      "layout": {
        "text-anchor": "top",
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["get", "name:nonlatin"],
          ["coalesce", ["get", "name"], ["get", "name:latin"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-offset": [0, 0.6],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#66736D",
        "text-halo-color": "#F7F8F5",
        "text-halo-width": 1
      }
    }
  ]
}
